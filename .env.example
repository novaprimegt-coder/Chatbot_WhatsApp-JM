# Copia este archivo como .env solo en el servidor/backend privado.
HOST=127.0.0.1
PORT=3000
WHATSAPP_MODE=mock

# Configuración compartida del webhook Meta
META_GRAPH_VERSION=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Varios números. Cada objeto vincula un Phone Number ID con su Access Token privado.
# El profileId debe coincidir con el ID del perfil configurado en data/number-profiles.json.
# Ejemplo (todo en una sola línea, sin publicar tokens reales en GitHub):
WHATSAPP_NUMBERS_JSON=[{"profileId":"default","phoneNumberId":"PHONE_NUMBER_ID_1","accessToken":"ACCESS_TOKEN_1"},{"profileId":"number-2","phoneNumberId":"PHONE_NUMBER_ID_2","accessToken":"ACCESS_TOKEN_2"}]

# Compatibilidad con la configuración anterior de un solo número (opcional):
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Si los números pertenecieran a más de una app Meta, se pueden validar varias firmas:
META_APP_SECRETS_JSON=[]
